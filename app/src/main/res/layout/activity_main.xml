<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="16dp">
            <Button android:id="@+id/btnModeServer" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="📡 Сервер"/>
            <Button android:id="@+id/btnModeClient" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="8dp" android:text="📥 Клиент"/>
        </LinearLayout>

        <!-- SERVER SECTION -->
        <LinearLayout android:id="@+id/srvSection" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Локальные IP-адреса:" android:textStyle="bold"/>
            <TextView android:id="@+id/tvLocalIps" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="…"/>
            <TextView android:id="@+id/tvSelectedFile" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Файл не выбран"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="6dp" android:layout_marginBottom="12dp">
                <Button android:id="@+id/btnPickFile" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="Выбрать файл"/>
                <Button android:id="@+id/btnClearFile" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="8dp" android:text="✕ Снять"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Текст для отправки:" android:textStyle="bold"/>
            <EditText android:id="@+id/etShareText" android:layout_width="match_parent"
                android:layout_height="100dp" android:gravity="top"
                android:inputType="textMultiLine" android:layout_marginBottom="12dp"/>
            <Button android:id="@+id/btnToggleServer" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="▶ Запустить сервер"/>
            <TextView android:id="@+id/tvServerStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="Сервер остановлен"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="Журнал подключений:" android:textStyle="bold"/>
            <TextView android:id="@+id/tvConnectionsLog" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="80dp" android:text=""/>
        </LinearLayout>

        <!-- CLIENT SECTION -->
        <LinearLayout android:id="@+id/cltSection" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="IP-адреса или ссылка:" android:textStyle="bold"/>
            <EditText android:id="@+id/etTargetInput" android:layout_width="match_parent"
                android:layout_height="90dp" android:gravity="top"
                android:inputType="textMultiLine" android:layout_marginBottom="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="4dp">
                <Button android:id="@+id/btnScan" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:text="Сканировать сеть"/>
                <Button android:id="@+id/btnGet" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="8dp" android:text="Получить"/>
            </LinearLayout>
            <Button android:id="@+id/btnContacts" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="📒 Контакты"/>
            <Button android:id="@+id/btnSettings" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="⚙ Настройки"/>
            <ProgressBar android:id="@+id/pbClient" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:max="100" android:progress="0"/>
            <TextView android:id="@+id/tvSpeed" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text=""/>
            <TextView android:id="@+id/tvClientStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:text=""/>
            <Button android:id="@+id/btnMove" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="8dp"
                android:text="↗ Переместить в другое место" android:visibility="gone"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Полученный текст:" android:textStyle="bold"/>
            <EditText android:id="@+id/etReceivedText" android:layout_width="match_parent"
                android:layout_height="120dp" android:gravity="top" android:inputType="textMultiLine"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>