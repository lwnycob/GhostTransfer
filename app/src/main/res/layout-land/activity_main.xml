<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:padding="6dp" android:baselineAligned="false">

    <!-- LEFT: SERVER (43%) -->
    <LinearLayout android:id="@+id/srvSection" android:layout_width="0dp"
        android:layout_height="match_parent" android:layout_weight="43"
        android:orientation="vertical" android:paddingEnd="6dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="📡 СЕРВЕР" android:textSize="11sp" android:textStyle="bold"
            android:textColor="#6750A4" android:paddingBottom="4dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="IP:" android:textSize="9sp" android:textColor="#757575"/>
        <TextView android:id="@+id/tvLocalIps" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="10sp" android:paddingBottom="4dp" android:text="…"/>
        <TextView android:id="@+id/tvSelectedFile" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="10sp" android:text="Файл не выбран"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="3dp" android:layout_marginBottom="3dp">
            <Button android:id="@+id/btnPickFile" android:layout_width="0dp" android:layout_height="34dp"
                android:layout_weight="1" android:textSize="10sp" android:focusable="true" android:text="Выбрать файл"/>
            <Button android:id="@+id/btnClearFile" android:layout_width="0dp" android:layout_height="34dp"
                android:layout_weight="1" android:layout_marginStart="3dp"
                android:textSize="10sp" android:focusable="true" android:text="✕ Снять"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Текст:" android:textSize="9sp" android:textColor="#757575"/>
        <EditText android:id="@+id/etShareText" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:gravity="top"
            android:inputType="textMultiLine" android:textSize="11sp" android:focusable="true" android:focusableInTouchMode="true"/>
        <Button android:id="@+id/btnToggleServer" android:layout_width="match_parent"
            android:layout_height="36dp" android:layout_marginTop="4dp"
            android:textSize="11sp" android:focusable="true" android:text="▶ Запустить сервер"/>
        <TextView android:id="@+id/tvServerStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="10sp" android:paddingTop="2dp" android:text="Сервер остановлен"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Журнал:" android:textSize="9sp" android:textColor="#757575" android:paddingTop="4dp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvConnectionsLog" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:textSize="9sp" android:text=""/>
    </LinearLayout>

    <View android:layout_width="1dp" android:layout_height="match_parent"
        android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="#E0E0E0"/>

    <!-- RIGHT: CLIENT (57%) -->
    <LinearLayout android:id="@+id/cltSection" android:layout_width="0dp"
        android:layout_height="match_parent" android:layout_weight="57"
        android:orientation="vertical" android:paddingStart="6dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="📥 КЛИЕНТ" android:textSize="11sp" android:textStyle="bold"
            android:textColor="#6750A4" android:paddingBottom="4dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="IP или ссылка:" android:textSize="9sp" android:textColor="#757575"/>
        <EditText android:id="@+id/etTargetInput" android:layout_width="match_parent"
            android:layout_height="38dp" android:gravity="center_vertical" android:inputType="text"
            android:textSize="13sp" android:focusable="true" android:focusableInTouchMode="true" android:imeOptions="actionDone"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="3dp">
            <Button android:id="@+id/btnScan" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:textSize="10sp" android:focusable="true" android:text="Сканировать"/>
            <Button android:id="@+id/btnGet" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginStart="3dp"
                android:textSize="10sp" android:focusable="true" android:text="Получить"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="3dp">
            <Button android:id="@+id/btnContacts" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:textSize="10sp" android:focusable="true" android:text="Контакты"/>
            <Button android:id="@+id/btnSettings" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginStart="3dp"
                android:textSize="10sp" android:focusable="true" android:text="Настройки"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/pbClient" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:max="100" android:progress="0"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/tvSpeed" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="10sp" android:paddingEnd="6dp" android:text=""/>
            <TextView android:id="@+id/tvClientStatus" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:textSize="10sp" android:text=""/>
        </LinearLayout>
        <Button android:id="@+id/btnMove" android:layout_width="match_parent" android:layout_height="34dp"
            android:layout_marginTop="2dp" android:textSize="10sp" android:focusable="true"
            android:text="↗ Переместить" android:visibility="gone"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Полученный текст:" android:textSize="9sp" android:textColor="#757575"
            android:textStyle="bold" android:paddingTop="4dp"/>
        <EditText android:id="@+id/etReceivedText" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:gravity="top"
            android:inputType="textMultiLine" android:textSize="11sp"
            android:focusable="true" android:focusableInTouchMode="true"/>
    </LinearLayout>

    <!-- Hidden mode buttons needed by Java code -->
    <Button android:id="@+id/btnModeServer" android:layout_width="0dp"
        android:layout_height="0dp" android:visibility="gone"/>
    <Button android:id="@+id/btnModeClient" android:layout_width="0dp"
        android:layout_height="0dp" android:visibility="gone"/>
</LinearLayout>